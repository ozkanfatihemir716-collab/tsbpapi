    cl.Parent = hd; Instance.new("UICorner", cl).CornerRadius = UDim.new(1, 0)
    cl.MouseButton1Click:Connect(function() sg:Destroy() end)

    -- Sürükle
    local sd, ss, sp
    hd.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sd = true; ss = i.Position; sp = fr.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sd and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ss
            fr.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sd = false end
    end)

    -- Slider oluşturucu
    local function createSlider(yPos, label, minV, maxV, currentVal, callback)
        local lbl = Instance.new("TextLabel", fr)
        lbl.Size = UDim2.new(1, -20, 0, 18)
        lbl.Position = UDim2.new(0, 10, 0, yPos)
        lbl.BackgroundTransparency = 1
        lbl.Text = label .. ": " .. currentVal
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local dn = Instance.new("TextButton", fr)
        dn.Size = UDim2.new(0, 55, 0, 22)
        dn.Position = UDim2.new(0, 10, 0, yPos + 20)
        dn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        dn.Text = "-"
        dn.TextColor3 = Color3.new(1, 1, 1)
        dn.Font = Enum.Font.GothamBold
        dn.TextSize = 12
        dn.Parent = fr
        Instance.new("UICorner", dn).CornerRadius = UDim.new(0, 4)

        local up = Instance.new("TextButton", fr)
        up.Size = UDim2.new(0, 55, 0, 22)
        up.Position = UDim2.new(1, -65, 0, yPos + 20)
        up.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        up.Text = "+"
        up.TextColor3 = Color3.new(1, 1, 1)
        up.Font = Enum.Font.GothamBold
        up.TextSize = 12
        up.Parent = fr
        Instance.new("UICorner", up).CornerRadius = UDim.new(0, 4)

        local step = (maxV - minV) / 20

        dn.MouseButton1Click:Connect(function()
            currentVal = math.max(minV, currentVal - step)
            lbl.Text = label .. ": " .. math.floor(currentVal)
            callback(currentVal)
        end)
        up.MouseButton1Click:Connect(function()
            currentVal = math.min(maxV, currentVal + step)
            lbl.Text = label .. ": " .. math.floor(currentVal)
            callback(currentVal)
        end)
    end

    createSlider(40, "Hız", 16, 200, Settings.WalkSpeed, function(v) Settings.WalkSpeed = v end)
    createSlider(90, "Zıplama", 50, 300, Settings.JumpPower, function(v) Settings.JumpPower = v end)
    createSlider(140, "FOV", 70, 120, Settings.FOV, function(v) Camera.FieldOfView = v end)
    createSlider(190, "Max Zoom", 128, 500, Settings.MaxZoom, function(v) LocalPlayer.CameraMaxZoomDistance = v end)
end)

