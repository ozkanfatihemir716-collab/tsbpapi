-- ==================== ANA LOOP ====================
RunService.Heartbeat:Connect(function(dt)
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return end

    if G.Speed then myHum.WalkSpeed = Settings.WalkSpeed * Settings._BoostWalk
    else myHum.WalkSpeed = 16 end
    if G.Jump then myHum.UseJumpPower = true; myHum.JumpPower = Settings.JumpPower * Settings._BoostJump end

    if myHum.Health <= 0 then return end

    local nearest, minDist = nil, 200
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myHrp.Position - root.Position).Magnitude
                if dist < minDist then minDist = dist; nearest = p end
            end
        end
    end

    if G.Dash then
        dashCooldown = dashCooldown - dt
        if dashCooldown <= 0 and nearest and minDist < 1.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local frontPos = tHrp.Position + tHrp.CFrame.LookVector * 2
                myHrp.CFrame = CFrame.lookAt(frontPos, tHrp.Position)
                myHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                dashCooldown = 0.4
            end
        end
    end

    if G.Stick then
        stickCooldown = stickCooldown - dt
        if stickCooldown <= 0 and nearest and minDist < 3.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local lookVec = tHrp.CFrame.LookVector
                local horizontalLook = Vector3.new(lookVec.X, 0, lookVec.Z)
                if horizontalLook.Magnitude < 0.01 then horizontalLook = Vector3.new(0, 0, -1) end
                horizontalLook = horizontalLook.Unit
                local behindPos = tHrp.Position - horizontalLook * 2.5
                myHrp.CFrame = CFrame.lookAt(behindPos, behindPos + horizontalLook)
                myHrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                stickCooldown = 2
            end
        end
    end
end)

