RunService.Heartbeat:Connect(function()
    if not stickyTarget then
        stickyLabel.Text = "🧲 Yapışma: Boşta"
        stickyLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        return
    end

    if not stickyTarget.Parent or not stickyTarget.Character then
        stickyTarget = nil
        return
    end
    local tChar = stickyTarget.Character
    local tHrp = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    if not tHrp or not tHum or tHum.Health <= 0 then
        stickyTarget = nil
        return
    end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local lookVec = tHrp.CFrame.LookVector
    local horizontalLook = Vector3.new(lookVec.X, 0, lookVec.Z)
    if horizontalLook.Magnitude < 0.01 then
        horizontalLook = Vector3.new(0, 0, -1)
    end
    horizontalLook = horizontalLook.Unit

    local behindPos = tHrp.Position - horizontalLook * 2.5
    myHrp.CFrame = CFrame.lookAt(behindPos, behindPos + horizontalLook)
    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

    stickyLabel.Text = "🧲 Yapışık: " .. stickyTarget.Name
    stickyLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
end)

-- ==================== OTOMATİK KILL (5s Timeout + ForceField) ====================
local autoKillSwingCooldown = 0

RunService.Heartbeat:Connect(function(dt)
    if not Settings.AutoKill then
        autoKillLabel.Text = "⚔️ Auto Kill: Boşta"
        autoKillLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        autoKillAttackTimer = 0
        return
    end

    autoKillSwingCooldown = autoKillSwingCooldown - dt

    -- Kill listesini yenile
    if #autoKillList == 0 or not autoKillTarget then
        refreshAutoKillList()
        if #autoKillList > 0 then
            autoKillIndex = 1
            autoKillTarget = autoKillList[1]
            autoKillAttackTimer = 0
        end
    end

    -- Geçerli hedef kontrol
    if autoKillTarget then
        local tChar = autoKillTarget.Character
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not autoKillTarget.Parent or not tChar or not tHum or tHum.Health <= 0 then
            -- Hedef öldü → sıradakine geç
            autoKillIndex = autoKillIndex + 1
            if autoKillIndex > #autoKillList then
                autoKillIndex = 1
                refreshAutoKillList()
            end
            autoKillTarget = autoKillList[autoKillIndex]
            autoKillAttackTimer = 0
            autoKillSwingCooldown = 0.3
        end
    end

    if not autoKillTarget then return end

    -- ✅ KALKAN KONTROLÜ: Hedefte kalkan varsa bekle
    if hasForceField(autoKillTarget) then
        autoKillLabel.Text = "🛡️ Kalkan bekleniyor: " .. autoKillTarget.Name
        autoKillLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
        autoKillAttackTimer = 0 -- Timeout sıfırla, kalkan kalkınca tekrar başlar
        -- Hedefe yapışma, sadece bekle
        return
    end

    local tChar = autoKillTarget.Character
    if not tChar then return end
    local tHrp = tChar:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return end

    -- 5 saniye timeout
    autoKillAttackTimer = autoKillAttackTimer + dt
    if autoKillAttackTimer >= 5 then
        showToast("5s doldu! Sıradaki hedef", "⏱️")
        autoKillIndex = autoKillIndex + 1
        if autoKillIndex > #autoKillList then
            autoKillIndex = 1
            refreshAutoKillList()
        end
        autoKillTarget = autoKillList[autoKillIndex]
        autoKillAttackTimer = 0
        autoKillSwingCooldown = 0.3
        return
    end

    -- Hedefin arkasına yapış
    local lookVec = tHrp.CFrame.LookVector
    local horizontalLook = Vector3.new(lookVec.X, 0, lookVec.Z)
    if horizontalLook.Magnitude < 0.01 then
        horizontalLook = Vector3.new(0, 0, -1)
    end
    horizontalLook = horizontalLook.Unit

    local behindPos = tHrp.Position - horizontalLook * 2.5
    myHrp.CFrame = CFrame.lookAt(behindPos, behindPos + horizontalLook)
    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

    -- Kılıç salla
    if autoKillSwingCooldown <= 0 then
        -- ✅ Kılıç elde değilse geri al
        if not myChar:FindFirstChildOfClass("Tool") then
            equipSword()
        end
        swingWeapon()
        autoKillSwingCooldown = 0.25
    end

    local remain = math.ceil(5 - autoKillAttackTimer)
    autoKillLabel.Text = "⚔️ " .. autoKillTarget.Name .. " (" .. autoKillIndex .. "/" .. #autoKillList .. ") · " .. remain .. "s"
    autoKillLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
end)

