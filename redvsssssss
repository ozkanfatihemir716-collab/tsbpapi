-- ==================== YARDIMCI ====================
local function getAimPart(char)
    if Settings.AimPart == "Random" then
        local parts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"}
        local valid = {}
        for _, n in ipairs(parts) do
            if char:FindFirstChild(n) then table.insert(valid, n) end
        end
        if #valid == 0 then return nil end
        return char:FindFirstChild(valid[math.random(1, #valid)])
    end
    local part = char:FindFirstChild(Settings.AimPart)
    if not part then part = char:FindFirstChild("Head") end
    if not part then part = char:FindFirstChild("HumanoidRootPart") end
    return part
end

local function getNearestTarget()
    local best, bestDist = nil, math.huge
    local bestPart = nil
    local myChar = LocalPlayer.Character
    if not myChar then return nil, nil end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil, nil end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not hasForceField(p) then
                local part = getAimPart(p.Character)
                if part then
                    local dist = (myHrp.Position - part.Position).Magnitude
                    if dist <= Settings.MaxRange and dist < bestDist then
                        bestDist = dist; best = p; bestPart = part
                    end
                end
            end
        end
    end
    return best, bestPart
end

local function refreshAutoKillList()
    autoKillList = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(autoKillList, p)
            end
        end
    end
end

