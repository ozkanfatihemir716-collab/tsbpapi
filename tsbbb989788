local activeShines = {}
local function createShineOverlay(parent, cr, dur)
    dur = dur or 2.2
    local s = Instance.new("Frame")
    s.Name = "ShineFX"; s.Size = UDim2.new(1,0,1,0)
    s.BackgroundColor3 = Color3.fromRGB(255,255,255)
    s.BackgroundTransparency = 0.85
    s.BorderSizePixel = 0
    s.ZIndex = 10; s.Active = false; s.Parent = parent
    if cr then Instance.new("UICorner", s).CornerRadius = cr end
    local g = Instance.new("UIGradient", s)
    g.Rotation = 25; g.Color = ColorSequence.new(Color3.fromRGB(255,255,255))
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.40,1),
        NumberSequenceKeypoint.new(0.50,0.15),NumberSequenceKeypoint.new(0.60,1),
        NumberSequenceKeypoint.new(1,1),
    })
    g.Offset = Vector2.new(-1.3,0)
    table.insert(activeShines, {shine=s, grad=g, duration=dur, active=true})
    return s
end

task.spawn(function()
    while true do
        -- FPS Kalkanı: low modda shine tamamen durur
        if perfMode == "low" then
            task.wait(0.5)
        else
            task.wait(perfMode == "mid" and 0.066 or 0.033)
            for i = #activeShines, 1, -1 do
                local d = activeShines[i]
                if not d.shine.Parent then table.remove(activeShines, i)
                elseif d.active then
                    d.grad.Offset = d.grad.Offset + Vector2.new(0.033 / d.duration * 2.6, 0)
                    if d.grad.Offset.X > 1.3 then
                        d.grad.Offset = Vector2.new(-1.3, 0); d.active = false
                        task.delay(2.5, function() if d.shine.Parent then d.active = true end end)
                    end
                end
            end
        end
    end
end)

