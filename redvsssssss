-- ==================== TAKIM ====================
local function isTeammate(p)
    if p == LocalPlayer then return true end
    local myTeam = LocalPlayer.Team
    local pTeam = p.Team
    if not myTeam or not pTeam then return false end
    return pTeam == myTeam
end

local function hasForceField(p)
    if not p.Character then return false end
    return p.Character:FindFirstChildOfClass("ForceField") ~= nil
end

local function getTeamLabel(p)
    if not p.Team then return "⬜ YOK" end
    local name = p.Team.Name:lower()
    if name:find("red") or name:find("kırmızı") or name:find("kirmizi") then
        return "🔴 KIRMIZI"
    elseif name:find("blue") or name:find("mavi") then
        return "🔵 MAVİ"
    else
        return "⚪ " .. p.Team.Name
    end
end

local function getTeamColor(p)
    if not p.Team then return Color3.fromRGB(180, 180, 180) end
    local name = p.Team.Name:lower()
    if name:find("red") or name:find("kırmızı") or name:find("kirmizi") then
        return Color3.fromRGB(255, 80, 80)
    elseif name:find("blue") or name:find("mavi") then
        return Color3.fromRGB(80, 140, 255)
    else
        return Color3.fromRGB(180, 180, 180)
    end
end

