-- ==================== ESP (Optimize Edilmiş) ====================
local function createESPForPlayer(p)
    if espData[p] or not p.Character then return end
    local char = p.Character
    local head = char:FindFirstChild("Head")
    if not head then return end

    local hl = Instance.new("Highlight")
    hl.Name = "TSB_HL"
    hl.FillColor = Color3.fromRGB(255, 50, 50)
    hl.OutlineColor = Color3.fromRGB(255, 100, 100)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Adornee = char
    hl.Parent = char

    local bb = Instance.new("BillboardGui")
    bb.Name = "TSB_BB"
    bb.Adornee = head
    bb.Size = UDim2.new(4, 0, 1.2, 0)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 300
    bb.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = p.Name
    label.TextColor3 = Color3.fromRGB(255, 80, 80)
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = bb

    espData[p] = { highlight = hl, billboard = bb, label = label, character = char }
end

local function removeESPForPlayer(p)
    local data = espData[p]
    if data then
        pcall(function() data.highlight:Destroy() end)
        pcall(function() data.billboard:Destroy() end)
        espData[p] = nil
    end
end

local function cleanAllESP()
    for p, _ in pairs(espData) do removeESPForPlayer(p) end
    espData = {}
end

local function refreshESP()
    if not espEnabled then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local data = espData[p]
            if hum and hum.Health > 0 then
                -- Karakter değişti mi veya ESP kırıldı mı?
                if not data or data.character ~= p.Character or not data.highlight.Parent then
                    if data then removeESPForPlayer(p) end
                    createESPForPlayer(p)
                end
            else
                if data then removeESPForPlayer(p) end
            end
        elseif espData[p] then
            removeESPForPlayer(p)
        end
    end
    -- Ayrılan oyuncuları temizle
    for p, _ in pairs(espData) do
        if not p.Parent then removeESPForPlayer(p) end
    end
end

