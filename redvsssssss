        local smooth = math.clamp(Settings.Smoothness, 0, 0.95)
        if smooth <= 0.01 then
            Camera.CFrame = targetCF
        else
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 - smooth)
        end
    end
end)

