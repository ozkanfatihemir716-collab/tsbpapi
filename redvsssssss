RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if Settings.Speed then hum.WalkSpeed = Settings.WalkSpeed else hum.WalkSpeed = 16 end
            if Settings.Jump then hum.UseJumpPower = true; hum.JumpPower = Settings.JumpPower end
        end
    end

    if Settings.Aimlock then
        if currentTarget then
            local hum = currentTarget.Character and currentTarget.Character:FindFirstChildOfClass("Humanoid")
            local valid = currentTarget.Parent and currentTarget.Character and hum and hum.Health > 0
                and aimTargetPart and aimTargetPart.Parent
            if not valid then currentTarget = nil; aimTargetPart = nil end
        end
        if not currentTarget then
            local t, part = getNearestTarget()
            if t and part then currentTarget = t; aimTargetPart = part end
        end
    else
        currentTarget = nil; aimTargetPart = nil
    end
end)

RunService:BindToRenderStep("RVBCamFix", Enum.RenderPriority.Camera.Value + 1, function(dt)
