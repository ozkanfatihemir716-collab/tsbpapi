local espData = {}

local function getHealthColor(hum)
    local ratio = hum.Health / math.max(1, hum.MaxHealth)
    if ratio > 0.6 then return Color3.fromRGB(100, 220, 150)
    elseif ratio > 0.3 then return Color3.fromRGB(255, 200, 80)
    else return Color3.fromRGB(255, 90, 90) end
end

local function getAdornee(char)
    return char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
end

local function removeESP(p)
    local d = espData[p]
    if d then
        if d.billboard then d.billboard:Destroy() end
        if d.highlight then d.highlight:Destroy() end
        espData[p] = nil
    end
end

function cleanAllESP()
    for p, _ in pairs(espData) do removeESP(p) end
    espData = {}
end

