        local s = ": " .. (math.floor(currentVal * 10) / 10)
        for _, r in ipairs(TextRefs) do
            if r.el == lbl and r.isSlider then r.suffix = s end
        end
        valLbl.Text = tostring(math.floor(currentVal * 10) / 10)
    end
    dn.MouseButton1Click:Connect(function()
        currentVal = math.max(minV, currentVal - step)
        lbl.Text = L(labelKey) .. ": " .. (math.floor(currentVal * 10) / 10)
        refreshSuffix(); callback(currentVal)
    end)
    up.MouseButton1Click:Connect(function()
        currentVal = math.min(maxV, currentVal + step)
        lbl.Text = L(labelKey) .. ": " .. (math.floor(currentVal * 10) / 10)
        refreshSuffix(); callback(currentVal)
    end)
end

