local function equipSword()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    -- Zaten bir tool elde mi?
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then return true end

    -- Backpack'te kılıç var mı?
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return false end

    -- Önce "sword/kılıç/blade" içeren tool'u ara
    local candidates = {}
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if n:find("sword") or n:find("kılıç") or n:find("kilic") or n:find("blade") or n:find("katana") then
                table.insert(candidates, 1, tool) -- öne ekle (öncelikli)
            else
                table.insert(candidates, tool)
            end
        end
    end

    if #candidates == 0 then return false end

    pcall(function()
        hum:EquipTool(candidates[1])
    end)
    return true
end

local function swingWeapon()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
end

